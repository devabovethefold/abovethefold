---
import Base from '../layouts/Base.astro';
import CTABanner from '../components/CTABanner.astro';

const services = [
  {
    id: 'web-design',
    tag: 'Web Design',
    headline: 'Designs That Convert, Not Just Impress',
    body: "Every pixel is intentional. We craft websites that guide visitors toward a single goal — whether that's a phone call, a form submission, or a purchase. Beautiful is the baseline; effective is the standard.",
    benefits: [
      { label: 'Mobile-First, Always', detail: 'Over 60% of Florida web traffic is mobile. We design for small screens first, then scale up.' },
      { label: 'Brand-Aligned UI', detail: 'Your website looks and feels like an intentional extension of your brand, not a template.' },
      { label: 'Conversion Architecture', detail: 'Strategic layouts, clear CTAs, and visual hierarchy that guide visitors to act.' },
      { label: 'Accessibility Built-In', detail: 'WCAG 2.1 compliant designs so you reach every potential customer.' },
    ],
    stat: { before: 'Avg. 2.1% conversion rate', after: '6.8% after redesign', label: 'Avg. conversion lift' },
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12"><path d="M4 5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5z"/><path d="M4 13a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-6z"/><path d="M16 13a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-6z"/></svg>`,
  },
  {
    id: 'web-development',
    tag: 'Web Development',
    headline: 'Fast, Secure, and Built to Last',
    body: "We write clean, maintainable code deployed on world-class infrastructure. Our builds consistently hit 95+ on Google PageSpeed — because every second of load time costs you conversions. No bloated page builders, no technical debt.",
    benefits: [
      { label: 'Performance-First Stack', detail: 'Astro, Next.js, and modern frameworks that ship tiny JavaScript bundles by default.' },
      { label: '95+ PageSpeed Out of the Box', detail: 'Core Web Vitals optimization baked in from day one — not patched in after.' },
      { label: 'CMS Integration', detail: 'Easy content management via Sanity, WordPress, or your platform of choice.' },
      { label: 'E-Commerce Ready', detail: 'Shopify, WooCommerce, and custom checkout integrations for Florida retailers.' },
    ],
    stat: { before: 'Avg. 4.8s load time', after: '1.1s after rebuild', label: 'Avg. load time improvement' },
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12"><path d="M7 8l-4 4 4 4"/><path d="M17 8l4 4-4 4"/><path d="M14 4l-4 16"/></svg>`,
  },
  {
    id: 'seo',
    tag: 'SEO',
    headline: 'Get Found by Customers Who Are Already Looking',
    body: "We build sustainable organic visibility through technical SEO, local optimization, and content strategy. No shortcuts, no tricks — just the kind of rankings that compound over time and survive algorithm updates.",
    benefits: [
      { label: 'Local Florida SEO', detail: 'Google Business Profile optimization, local citations, and map pack rankings for your area.' },
      { label: 'Technical SEO Audits', detail: 'Site architecture, crawlability, Core Web Vitals, and structured data — all optimized.' },
      { label: 'Keyword Strategy', detail: 'Research-backed targeting of the exact terms your ideal customers are searching.' },
      { label: 'Monthly Reporting', detail: 'Clear, plain-English reports showing rank movement, traffic growth, and ROI.' },
    ],
    stat: { before: 'Avg. 380 monthly organic visits', after: '1,940 after 6 months', label: 'Avg. organic traffic growth' },
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/><path d="M3.6 9h16.8M3.6 15h16.8M11.5 3a17 17 0 0 0 0 18M12.5 3a17 17 0 0 1 0 18"/></svg>`,
  },
  {
    id: 'branding',
    tag: 'Business Branding',
    headline: 'A Brand That Commands Respect Before You Speak',
    body: "Your visual identity is your first impression in every room — and every search result. We build cohesive brand systems that make you look like the established authority you are. Because perception is the first part of the sale.",
    benefits: [
      { label: 'Logo Design & Brand Mark', detail: 'Versatile logos built for every application, from business cards to billboards.' },
      { label: 'Color & Typography System', detail: 'A strategic palette and type hierarchy that communicates the right emotion every time.' },
      { label: 'Brand Guidelines Document', detail: 'A comprehensive rulebook so your brand stays consistent across every touchpoint.' },
      { label: 'Social & Print Collateral', detail: 'Business cards, letterhead, email signatures, and social media kits included.' },
    ],
    stat: { before: 'Avg. 34% trust score (pre-brand)', after: '71% after rebrand', label: 'Customer trust perception lift' },
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12"><path d="M12 3l1.912 5.813a2 2 0 0 0 1.272 1.272L21 12l-5.816 1.916a2 2 0 0 0-1.272 1.272L12 21l-1.912-5.812a2 2 0 0 0-1.272-1.272L3 12l5.816-1.916a2 2 0 0 0 1.272-1.272L12 3z"/></svg>`,
  },
];

const servicesSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": "Web Design",
      "description": "Conversion-oriented, beautiful, and fully custom UI/UX design tailored specifically to local Florida businesses.",
      "provider": { "@type": "Organization", "name": "Above The Fold", "url": "https://abovethefold.biz" },
      "areaServed": "US-FL"
    },
    {
      "@type": "Service",
      "name": "Web Development",
      "description": "Blazing-fast, custom coded websites using modern static site generators and frameworks that achieve perfect 95+ PageSpeed scores.",
      "provider": { "@type": "Organization", "name": "Above The Fold", "url": "https://abovethefold.biz" },
      "areaServed": "US-FL"
    },
    {
      "@type": "Service",
      "name": "SEO & Organic Positioning",
      "description": "Strategic search engine optimization, Local SEO, Google Business profile enhancement, and crawl-friendly technical indexing strategies.",
      "provider": { "@type": "Organization", "name": "Above The Fold", "url": "https://abovethefold.biz" },
      "areaServed": "US-FL"
    },
    {
      "@type": "Service",
      "name": "Business Branding",
      "description": "High-fidelity modern business branding packages, visual design systems, print collateral, logos, and custom typography frameworks.",
      "provider": { "@type": "Organization", "name": "Above The Fold", "url": "https://abovethefold.biz" },
      "areaServed": "US-FL"
    }
  ]
};
---

<Base
  title="Services — Above The Fold"
  description="Web design, development, SEO, and business branding services for Florida businesses. Performance-first. Results-focused."
  customSchema={servicesSchema}
>
  <!-- Page hero -->
  <section class="bg-brand-navy pt-20 pb-24 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <svg class="absolute top-0 right-0 w-72 h-72 opacity-[0.04]" viewBox="0 0 288 288" fill="none">
        <path d="M144 18 L162 121 L265 144 L162 167 L144 270 L126 167 L23 144 L126 121 Z" fill="white"/>
      </svg>
      <svg class="absolute bottom-0 left-16 w-40 h-40 opacity-[0.03]" viewBox="0 0 160 160" fill="none">
        <path d="M80 10 L90 68 L148 80 L90 92 L80 150 L70 92 L12 80 L70 68 Z" fill="white"/>
      </svg>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center relative">
      <div
        x-data="{ visible: false }"
        x-intersect.once="visible = true"
        :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
        class="transition-all duration-700 ease-out"
      >
        <span class="inline-flex items-center gap-1.5 text-brand-orange font-body font-medium text-xs uppercase tracking-widest mb-5">
          <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 L7 4.8 L12 6 L7 7.2 L6 12 L5 7.2 L0 6 L5 4.8 Z"/></svg>
          Services
        </span>
        <h1 class="font-display font-extrabold text-white text-4xl sm:text-5xl tracking-tight mb-5">
          Everything You Need to Dominate Online
        </h1>
        <p class="font-body text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
          Four disciplines. One focused team. Measurable results for Florida businesses of every size.
        </p>
      </div>

      <!-- Service quick-nav -->
      <div
        x-data="{ visible: false }"
        x-intersect.once="visible = true"
        :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
        class="transition-all duration-700 ease-out mt-10 flex flex-wrap justify-center gap-3"
        style="transition-delay: 150ms"
      >
        {services.map((s) => (
          <a
            href={`#${s.id}`}
            class="font-body text-sm font-medium text-white/60 hover:text-white border border-white/15 hover:border-white/30 px-4 py-2 rounded-full transition-all duration-200"
          >
            {s.tag}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Services -->
  <div class="bg-white">
    {services.map((service, i) => (
      <section
        id={service.id}
        class={`py-24 ${i % 2 === 1 ? 'bg-brand-surface' : 'bg-white'}`}
      >
        <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <div
            x-data="{ visible: false }"
            x-intersect.once="visible = true"
            :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
            class="transition-all duration-700 ease-out"
          >
            <div class={`grid grid-cols-1 lg:grid-cols-2 gap-16 items-start ${i % 2 === 1 ? 'lg:grid-flow-dense' : ''}`}>

              <!-- Text column -->
              <div class={i % 2 === 1 ? 'lg:col-start-2' : ''}>
                <span class="inline-flex items-center gap-1.5 text-brand-orange font-body font-medium text-xs uppercase tracking-widest mb-5">
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 L7 4.8 L12 6 L7 7.2 L6 12 L5 7.2 L0 6 L5 4.8 Z"/></svg>
                  {service.tag}
                </span>
                <h2 class="font-display font-extrabold text-brand-navy text-3xl sm:text-4xl tracking-tight mb-5 leading-tight">
                  {service.headline}
                </h2>
                <p class="font-body text-brand-navy/65 text-base leading-relaxed mb-8">
                  {service.body}
                </p>

                <!-- Benefits -->
                <div class="space-y-5 mb-10">
                  {service.benefits.map((benefit) => (
                    <div class="flex gap-4">
                      <div class="flex-shrink-0 w-8 h-8 rounded-lg bg-brand-orange/10 flex items-center justify-center mt-0.5">
                        <svg class="w-4 h-4 text-brand-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
                      </div>
                      <div>
                        <div class="font-display font-bold text-brand-navy text-sm mb-0.5">{benefit.label}</div>
                        <div class="font-body text-brand-navy/60 text-sm leading-relaxed">{benefit.detail}</div>
                      </div>
                    </div>
                  ))}
                </div>

                <!-- CTA -->
                <a
                  href="/contact"
                  class="btn-primary inline-flex items-center gap-2 bg-brand-orange hover:bg-brand-orange-dark text-white font-body font-medium text-sm px-7 py-3.5 rounded-lg shadow-sm"
                >
                  Get a Free Quote
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                </a>
              </div>

              <!-- Visual column -->
              <div class={i % 2 === 1 ? 'lg:col-start-1' : ''}>
                <div class="space-y-5">

                  <!-- Icon panel -->
                  <div
                    class={`rounded-2xl p-10 flex items-center justify-center relative overflow-hidden ${i % 2 === 1 ? 'bg-white' : 'bg-brand-surface'}`}
                    style="box-shadow: 0 2px 20px rgba(0,0,0,0.06); aspect-ratio: 4/3;"
                  >
                    <!-- Background star -->
                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
                      <svg class="w-64 h-64 opacity-[0.04]" viewBox="0 0 256 256" fill="none">
                        <path d="M128 16 L144 108 L236 128 L144 148 L128 240 L112 148 L20 128 L112 108 Z" fill="#1B2F5E"/>
                      </svg>
                    </div>
                    <!-- Large faded icon -->
                    <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
                      <div class="text-brand-navy opacity-[0.04] scale-[3]" set:html={service.icon} />
                    </div>
                    <!-- Foreground icon -->
                    <div class="relative z-10 text-brand-orange" set:html={service.icon.replace('class="w-12 h-12"', 'class="w-20 h-20"')} />
                  </div>

                  <!-- Stat card -->
                  <div class="rounded-xl p-6 bg-brand-navy relative overflow-hidden" style="box-shadow: 0 2px 20px rgba(0,0,0,0.12);">
                    <div class="absolute top-3 right-3 opacity-[0.08]" aria-hidden="true">
                      <svg class="w-16 h-16" viewBox="0 0 64 64" fill="none"><path d="M32 4 L37 27 L60 32 L37 37 L32 60 L27 37 L4 32 L27 27 Z" fill="white"/></svg>
                    </div>
                    <p class="font-body text-white/50 text-xs uppercase tracking-widest mb-3">{service.stat.label}</p>
                    <div class="flex items-center gap-4">
                      <div class="flex-1">
                        <div class="font-body text-white/40 text-xs mb-1">Before</div>
                        <div class="font-display font-bold text-white/70 text-sm">{service.stat.before}</div>
                      </div>
                      <svg class="w-5 h-5 text-brand-orange flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                      <div class="flex-1">
                        <div class="font-body text-brand-orange/80 text-xs mb-1">After</div>
                        <div class="font-display font-bold text-white text-sm">{service.stat.after}</div>
                      </div>
                    </div>
                  </div>

                </div>
              </div>

            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <CTABanner />
</Base>
