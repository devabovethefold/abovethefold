---
import Base from '../layouts/Base.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://abovethefold.biz/contact/#localbusiness",
  "name": "Above The Fold",
  "image": "https://abovethefold.biz/images/og-default.png",
  "url": "https://abovethefold.biz/contact",
  "telephone": "+15555555555",
  "email": "hello@abovethefold.biz",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Stuart",
    "addressRegion": "FL",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 27.1975,
    "longitude": -80.2528
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday"
    ],
    "opens": "09:00",
    "closes": "17:00"
  }
};
---

<Base
  title="Contact — Above The Fold"
  description="Get in touch with Above The Fold. Tell us about your Florida business and let's build something great."
  customSchema={contactSchema}
>
  <!-- Page hero -->
  <section class="bg-brand-navy pt-20 pb-24 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <svg class="absolute top-0 right-0 w-64 h-64 opacity-[0.04]" viewBox="0 0 256 256" fill="none">
        <path d="M128 16 L144 108 L236 128 L144 148 L128 240 L112 148 L20 128 L112 108 Z" fill="white"/>
      </svg>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center relative">
      <div
        x-data="{ visible: false }"
        x-intersect.once="visible = true"
        :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
        class="transition-all duration-700 ease-out"
      >
        <span class="inline-flex items-center gap-1.5 text-brand-orange font-body font-medium text-xs uppercase tracking-widest mb-5">
          <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 L7 4.8 L12 6 L7 7.2 L6 12 L5 7.2 L0 6 L5 4.8 Z"/></svg>
          Get In Touch
        </span>
        <h1 class="font-display font-extrabold text-white text-4xl sm:text-5xl tracking-tight mb-5">
          Let's Start Your Project
        </h1>
        <p class="font-body text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
          Free strategy session. No obligation. Just an honest conversation about what your business needs to grow online.
        </p>
      </div>
    </div>
  </section>

  <!-- Two-column contact layout -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-16 items-start">

        <!-- Left: contact info -->
        <div
          class="lg:col-span-2"
          x-data="{ visible: false }"
          x-intersect.once="visible = true"
          :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
          style="transition: all 0.7s ease-out"
        >
          <h2 class="font-display font-extrabold text-brand-navy text-2xl mb-4">Talk to a Real Person</h2>
          <p class="font-body text-brand-navy/65 text-sm leading-relaxed mb-8">
            We're a small, focused Florida team. You won't be handed off to a junior rep or an account manager. When you reach out, you talk directly to the people building your project.
          </p>

          <div class="space-y-5">
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-surface flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/>
                  <path d="M3 7l9 6 9-6"/>
                </svg>
              </div>
              <div>
                <div class="font-body font-medium text-brand-navy text-sm">Email</div>
                <a href="mailto:hello@abovethefold.biz" class="font-body text-brand-navy/60 text-sm hover:text-brand-orange transition-colors">hello@abovethefold.biz</a>
              </div>
            </div>

            <!-- <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-surface flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5-2.5 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>
                </svg>
              </div>
              <div>
                <div class="font-body font-medium text-brand-navy text-sm">Phone</div>
                <a href="tel:+15555555555" class="font-body text-brand-navy/60 text-sm hover:text-brand-orange transition-colors">(555) 555-5555</a>
              </div>
            </div> -->

            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-surface flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 11m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0"/>
                  <path d="M17.657 16.657l-4.243 4.243a2 2 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-body font-medium text-brand-navy text-sm">Location</div>
                <span class="font-body text-brand-navy/60 text-sm">Florida, United States</span>
              </div>
            </div>
          </div>

          <!-- Social -->
          <div class="mt-10 pt-8 border-t border-black/[0.06]">
            <p class="font-body font-medium text-brand-navy text-sm mb-4">Follow Along</p>
            <div class="flex items-center gap-4">
              <a href="#" aria-label="LinkedIn" class="w-9 h-9 rounded-lg bg-brand-surface flex items-center justify-center text-brand-navy/50 hover:text-brand-orange hover:bg-orange-50 transition-all duration-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4m0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/>
                  <path d="M8 11l0 5M8 8l0 .01M12 16l0-5M16 16v-3a2 2 0 0 0-4 0"/>
                </svg>
              </a>
              <a href="#" aria-label="Instagram" class="w-9 h-9 rounded-lg bg-brand-surface flex items-center justify-center text-brand-navy/50 hover:text-brand-orange hover:bg-orange-50 transition-all duration-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4m0 4a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4z"/>
                  <path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0M16.5 7.5l0 .01"/>
                </svg>
              </a>
              <a href="#" aria-label="Facebook" class="w-9 h-9 rounded-lg bg-brand-surface flex items-center justify-center text-brand-navy/50 hover:text-brand-orange hover:bg-orange-50 transition-all duration-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 10v4h3v7h4v-7h3l1-4h-4v-2a1 1 0 0 1 1-1h3V4h-3a5 5 0 0 0-5 5v2h-3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div
          class="lg:col-span-3"
          x-data="{ visible: false }"
          x-intersect.once="visible = true"
          :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
          style="transition: all 0.7s ease-out; transition-delay: 100ms"
        >
          <div class="bg-white rounded-2xl p-8 lg:p-10" style="box-shadow: 0 2px 20px rgba(0,0,0,0.06);">
            <div
              x-data="{
                loading: false,
                sent: false,
                form: {
                  name: '',
                  business: '',
                  email: '',
                  phone: '',
                  service: '',
                  message: ''
                },
                async submit() {
                  this.loading = true;
                  try {
                    const response = await fetch('/api/contact', {
                      method: 'POST',
                      headers: {
                        'Content-Type': 'application/json'
                      },
                      body: JSON.stringify(this.form)
                    });
                    if (response.ok) {
                      this.sent = true;
                    } else {
                      const errData = await response.json().catch(() => ({}));
                      alert(errData.error || 'Something went wrong. Please try again.');
                    }
                  } catch (error) {
                    console.error(error);
                    alert('Network error. Please try again.');
                  } finally {
                    this.loading = false;
                  }
                }
              }"
            >
              <!-- Success state -->
              <div x-show="sent" x-cloak class="text-center py-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-50 mb-5">
                  <svg class="w-8 h-8 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
                </div>
                <h3 class="font-display font-bold text-brand-navy text-xl mb-2">Message Received!</h3>
                <p class="font-body text-brand-navy/60 text-sm leading-relaxed">
                  Thanks for reaching out. We'll be in touch within one business day to schedule your free strategy session.
                </p>
              </div>

              <!-- Form -->
              <form
                x-show="!sent"
                @submit.prevent="submit"
                action="/api/contact"
                method="POST"
                class="space-y-5"
                novalidate
              >
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label for="name" class="block font-body font-medium text-brand-navy text-sm mb-1.5">Your Name <span class="text-brand-orange">*</span></label>
                    <input
                      id="name"
                      type="text"
                      x-model="form.name"
                      required
                      placeholder="Jane Smith"
                      class="w-full font-body text-sm text-brand-navy bg-brand-surface border border-black/[0.08] rounded-lg px-4 py-3 outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/10 transition-all placeholder:text-brand-navy/30"
                    />
                  </div>
                  <div>
                    <label for="business" class="block font-body font-medium text-brand-navy text-sm mb-1.5">Business Name <span class="text-brand-orange">*</span></label>
                    <input
                      id="business"
                      type="text"
                      x-model="form.business"
                      required
                      placeholder="Acme Co."
                      class="w-full font-body text-sm text-brand-navy bg-brand-surface border border-black/[0.08] rounded-lg px-4 py-3 outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/10 transition-all placeholder:text-brand-navy/30"
                    />
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <label for="email" class="block font-body font-medium text-brand-navy text-sm mb-1.5">Email <span class="text-brand-orange">*</span></label>
                    <input
                      id="email"
                      type="email"
                      x-model="form.email"
                      required
                      placeholder="jane@acme.com"
                      class="w-full font-body text-sm text-brand-navy bg-brand-surface border border-black/[0.08] rounded-lg px-4 py-3 outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/10 transition-all placeholder:text-brand-navy/30"
                    />
                  </div>
                  <div>
                    <label for="phone" class="block font-body font-medium text-brand-navy text-sm mb-1.5">Phone <span class="font-body font-normal text-brand-navy/40">(optional)</span></label>
                    <input
                      id="phone"
                      type="tel"
                      x-model="form.phone"
                      placeholder="(555) 000-0000"
                      class="w-full font-body text-sm text-brand-navy bg-brand-surface border border-black/[0.08] rounded-lg px-4 py-3 outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/10 transition-all placeholder:text-brand-navy/30"
                    />
                  </div>
                </div>

                <div>
                  <label for="service" class="block font-body font-medium text-brand-navy text-sm mb-1.5">Service Interest <span class="text-brand-orange">*</span></label>
                  <select
                    id="service"
                    x-model="form.service"
                    required
                    class="w-full font-body text-sm text-brand-navy bg-brand-surface border border-black/[0.08] rounded-lg px-4 py-3 outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/10 transition-all appearance-none cursor-pointer"
                  >
                    <option value="" disabled selected>Select a service...</option>
                    <option value="web-design">Web Design</option>
                    <option value="web-development">Web Development</option>
                    <option value="seo">SEO</option>
                    <option value="branding">Business Branding</option>
                    <option value="full-package">Full Package (Design + Dev + SEO)</option>
                    <option value="other">Other / Not Sure Yet</option>
                  </select>
                </div>

                <div>
                  <label for="message" class="block font-body font-medium text-brand-navy text-sm mb-1.5">Tell Us About Your Project <span class="text-brand-orange">*</span></label>
                  <textarea
                    id="message"
                    x-model="form.message"
                    required
                    rows="5"
                    placeholder="What's your business, what are your goals, and what's not working with your current online presence?"
                    class="w-full font-body text-sm text-brand-navy bg-brand-surface border border-black/[0.08] rounded-lg px-4 py-3 outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/10 transition-all resize-none placeholder:text-brand-navy/30"
                  ></textarea>
                </div>

                <button
                  type="submit"
                  :disabled="loading"
                  class="btn-primary w-full flex items-center justify-center gap-2 bg-brand-orange hover:bg-brand-orange-dark disabled:opacity-60 disabled:cursor-not-allowed text-white font-body font-medium text-sm px-6 py-3.5 rounded-lg shadow-sm"
                >
                  <span x-show="!loading">Send Message</span>
                  <span x-show="loading" x-cloak class="flex items-center gap-2">
                    <svg class="w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 3a9 9 0 1 0 9 9" stroke-linecap="round"/>
                    </svg>
                    Sending...
                  </span>
                </button>

                <p class="font-body text-xs text-brand-navy/40 text-center">
                  No spam, ever. We typically respond within one business day.
                </p>
              </form>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</Base>
