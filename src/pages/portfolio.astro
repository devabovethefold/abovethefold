---
import Base from '../layouts/Base.astro';
import CTABanner from '../components/CTABanner.astro';

const projects = [
  {
    name: 'Onio Insights',
    description: 'Data analytics platform — modernized brand identity and rebuilt from the ground up for performance.',
    beforeUrl: 'http://onioinsights.com/',
    afterUrl: 'https://onioinsights.pages.dev',
    beforeDomain: 'onioinsights.com',
    afterDomain: 'onioinsights.pages.dev',
    stat: '4× faster load time',
  },
  {
    name: 'ECLC Stuart',
    description: 'Early childhood learning center — clear messaging, better navigation, and local SEO overhaul.',
    beforeUrl: 'https://www.tbhfl.org/eclc',
    afterUrl: 'https://www.eclcstuart.com/',
    beforeDomain: 'tbhfl.org/eclc',
    afterDomain: 'eclcstuart.com',
    stat: '2× increase in inquiries',
  },
  {
    name: 'Beth Jordan Productions',
    description: 'Entertainment production company — elevated visual identity to match their premium positioning.',
    beforeUrl: 'https://bethjordanproductions.com/',
    afterUrl: 'https://bethjordanproductions.pages.dev/',
    beforeDomain: 'bethjordanproductions.com',
    afterDomain: 'bethjordanproductions.pages.dev',
    stat: '95+ PageSpeed score',
  },
  {
    name: 'Rocket Rentals USA',
    description: 'Equipment rental company — streamlined booking flow and mobile-first redesign drove more leads.',
    beforeUrl: 'https://www.rocketrentalsusa.com/',
    afterUrl: 'https://rocketrentals.pages.dev/',
    beforeDomain: 'rocketrentalsusa.com',
    afterDomain: 'rocketrentals.pages.dev',
    stat: '3× more quote requests',
  },
  {
    name: 'Kidz 4 A Cure',
    description: 'Nonprofit fundraising organization — rebuilt for trust, clarity, and donation conversion.',
    beforeUrl: 'https://www.kidz4acure.org/',
    afterUrl: 'https://kidz4acure.pages.dev/',
    beforeDomain: 'kidz4acure.org',
    afterDomain: 'kidz4acure.pages.dev',
    stat: '40% donation lift',
  },
];
---

<Base
  title="Portfolio — Above The Fold"
  description="Real before and after website transformations for Florida businesses. See our web design, development, and branding work."
>
  <!-- Page hero -->
  <section class="bg-brand-navy pt-20 pb-24 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <svg class="absolute top-0 right-0 w-72 h-72 opacity-[0.04]" viewBox="0 0 288 288" fill="none">
        <path d="M144 18 L162 121 L265 144 L162 167 L144 270 L126 167 L23 144 L126 121 Z" fill="white"/>
      </svg>
      <svg class="absolute bottom-0 left-16 w-40 h-40 opacity-[0.03]" viewBox="0 0 160 160" fill="none">
        <path d="M80 10 L90 68 L148 80 L90 92 L80 150 L70 92 L12 80 L70 68 Z" fill="white"/>
      </svg>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center relative">
      <div
        x-data="{ visible: false }"
        x-intersect.once="visible = true"
        :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
        class="transition-all duration-700 ease-out"
      >
        <span class="inline-flex items-center gap-1.5 text-brand-orange font-body font-medium text-xs uppercase tracking-widest mb-5">
          <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 L7 4.8 L12 6 L7 7.2 L6 12 L5 7.2 L0 6 L5 4.8 Z"/></svg>
          Our Work
        </span>
        <h1 class="font-display font-extrabold text-white text-4xl sm:text-5xl tracking-tight mb-5">
          Real Results for Real Florida Businesses
        </h1>
        <p class="font-body text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
          Every project below is a real Florida business we've helped grow online. Drag the slider to see the transformation.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="py-20 bg-brand-surface">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="flex flex-col gap-20">
        {projects.map((project, i) => (
          <div
            x-data="{ visible: false }"
            x-intersect.once="visible = true"
            :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
            class="transition-all duration-700 ease-out"
            style={`transition-delay: ${Math.min(i * 80, 200)}ms`}
          >
            <!-- Project header -->
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
              <div>
                <h2 class="font-display font-extrabold text-brand-navy text-2xl sm:text-3xl">{project.name}</h2>
                <p class="font-body text-brand-navy/60 text-sm mt-1">{project.description}</p>
              </div>
              <div class="flex-shrink-0">
                <span class="inline-flex items-center gap-1.5 bg-white border border-brand-orange/20 text-brand-navy font-body font-medium text-xs px-3 py-1.5 rounded-full" style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                  <svg class="w-3 h-3 text-brand-orange" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 L7 4.8 L12 6 L7 7.2 L6 12 L5 7.2 L0 6 L5 4.8 Z"/></svg>
                  {project.stat}
                </span>
              </div>
            </div>

            <!-- Comparison slider -->
            <div
              x-data="{
                pct: 50,
                dragging: false,
                beforeLoaded: true,
                afterLoaded: true,
                startDrag(e) {
                  this.dragging = true;
                  e.currentTarget.setPointerCapture(e.pointerId);
                },
                onDrag(e) {
                  if (!this.dragging) return;
                  const rect = e.currentTarget.getBoundingClientRect();
                  this.pct = Math.min(100, Math.max(0, ((e.clientX - rect.left) / rect.width) * 100));
                },
                stopDrag() { this.dragging = false; }
              }"
              @pointerdown="startDrag"
              @pointermove="onDrag"
              @pointerup="stopDrag"
              @pointercancel="stopDrag"
              class="relative overflow-hidden rounded-xl select-none"
              style="width: 100%; aspect-ratio: 16/9; border-radius: 12px; cursor: ew-resize; box-shadow: 0 4px 32px rgba(0,0,0,0.12);"
            >
              <!-- BEFORE iframe (left, full width) -->
              <div class="absolute inset-0">
                <iframe
                  src={project.beforeUrl}
                  title={`${project.name} — Before`}
                  loading="lazy"
                  style="position: absolute; inset: 0; width: 100%; height: 100%; border: none; pointer-events: none;"
                  sandbox="allow-scripts allow-same-origin"
                  onload="this.style.opacity='1'"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                ></iframe>
                <!-- Before fallback -->
                <div class="absolute inset-0 bg-white items-center justify-center flex-col gap-3 text-center px-6" style="display: none;">
                  <svg class="w-8 h-8 text-brand-navy/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/><path d="M3.6 9h16.8M3.6 15h16.8M11.5 3a17 17 0 0 0 0 18M12.5 3a17 17 0 0 1 0 18"/></svg>
                  <p class="font-body text-brand-navy/50 text-sm">{project.beforeDomain}</p>
                  <a href={project.beforeUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-brand-orange font-body font-medium text-sm hover:underline" style="pointer-events: all;">
                    Visit Site
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                </div>
              </div>

              <!-- AFTER iframe (right, clipped) -->
              <div
                class="absolute inset-0"
                :style="'clip-path: inset(0 0 0 ' + pct + '%)'"
              >
                <iframe
                  src={project.afterUrl}
                  title={`${project.name} — After`}
                  loading="lazy"
                  style="position: absolute; inset: 0; width: 100%; height: 100%; border: none; pointer-events: none;"
                  sandbox="allow-scripts allow-same-origin"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                ></iframe>
                <!-- After fallback -->
                <div class="absolute inset-0 bg-brand-surface items-center justify-center flex-col gap-3 text-center px-6" style="display: none;">
                  <svg class="w-8 h-8 text-brand-orange/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/><path d="M3.6 9h16.8M3.6 15h16.8M11.5 3a17 17 0 0 0 0 18M12.5 3a17 17 0 0 1 0 18"/></svg>
                  <p class="font-body text-brand-navy/50 text-sm">{project.afterDomain}</p>
                  <a href={project.afterUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-brand-orange font-body font-medium text-sm hover:underline" style="pointer-events: all;">
                    Visit Site
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                </div>
              </div>

              <!-- Divider line -->
              <div
                class="absolute top-0 bottom-0 pointer-events-none"
                :style="'left: ' + pct + '%'"
                style="width: 2px; background: white; transform: translateX(-50%); z-index: 10;"
              >
                <!-- Handle -->
                <div
                  class="absolute top-1/2 left-1/2"
                  style="transform: translate(-50%, -50%); width: 40px; height: 40px; border-radius: 50%; background: #E8601A; display: flex; align-items: center; justify-content: center; box-shadow: 0 2px 12px rgba(0,0,0,0.25);"
                >
                  <!-- Arrows horizontal icon -->
                  <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 9l-3 3 3 3"/>
                    <path d="M17 9l3 3-3 3"/>
                    <line x1="4" y1="12" x2="20" y2="12"/>
                  </svg>
                </div>
              </div>

              <!-- Labels -->
              <div class="absolute top-3 left-3 pointer-events-none z-20">
                <span class="font-body font-medium text-xs px-2.5 py-1 rounded-full" style="background: rgba(0,0,0,0.45); color: #fff; backdrop-filter: blur(4px);">Before</span>
              </div>
              <div
                class="absolute top-3 pointer-events-none z-20"
                :style="'left: calc(' + pct + '% + 0.75rem)'"
              >
                <span class="font-body font-medium text-xs px-2.5 py-1 rounded-full" style="background: #E8601A; color: #fff;">After</span>
              </div>

              <!-- Touch hint -->
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 pointer-events-none z-20 opacity-60"
                x-show="pct === 50"
                x-transition:leave="transition ease-in duration-500"
                x-transition:leave-end="opacity-0"
              >
                <span class="font-body text-xs text-white bg-black/40 backdrop-blur-sm px-2.5 py-1 rounded-full">Drag to compare</span>
              </div>
            </div>

            <!-- Visit links -->
            <div class="flex items-center gap-6 mt-4">
              <a href={project.beforeUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-body text-xs text-brand-navy/50 hover:text-brand-navy transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                Old site
              </a>
              <div class="w-px h-3 bg-brand-navy/15"></div>
              <a href={project.afterUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-body text-xs text-brand-orange hover:text-brand-orange-dark transition-colors font-medium">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                New site
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Base>
