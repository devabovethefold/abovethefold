---
import Base from '../layouts/Base.astro';
import CTABanner from '../components/CTABanner.astro';

const projects = [
  {
    slug: 'onio-insights',
    name: 'Onio Insights',
    description: 'Data analytics platform — modernized brand identity and rebuilt from the ground up for performance.',
    afterImg: '/images/portfolio/onio-after.png',
    stat: '4× faster load time',
    tags: ['SaaS', 'Modernization', 'Analytics']
  },
  {
    slug: 'eclc-stuart',
    name: 'ECLC Stuart',
    description: 'Early childhood learning center — clear messaging, better navigation, and local SEO overhaul.',
    afterImg: '/images/portfolio/eclc-after.png',
    stat: '2× increase in inquiries',
    tags: ['Education', 'Local SEO', 'Web Design']
  },
  {
    slug: 'beth-jordan-productions',
    name: 'Beth Jordan Productions',
    description: 'Entertainment production company — elevated visual identity to match their premium positioning.',
    afterImg: '/images/portfolio/beth-after.png',
    stat: '95+ PageSpeed score',
    tags: ['Entertainment', 'Branding', 'Cinematic UI']
  },
  {
    slug: 'rocket-rentals-usa',
    name: 'Rocket Rentals USA',
    description: 'Equipment rental company — streamlined booking flow and mobile-first redesign drove more leads.',
    afterImg: '/images/portfolio/rocket-after.png',
    stat: '3× more quote requests',
    tags: ['Equipment Rental', 'E-Commerce', 'Mobile First']
  },
  {
    slug: 'kidz-4-a-cure',
    name: 'Kidz 4 A Cure',
    description: 'Nonprofit fundraising organization — rebuilt for trust, clarity, and donation conversion.',
    afterImg: '/images/portfolio/kidz-after.png',
    stat: '40% donation lift',
    tags: ['Nonprofit', 'Giving UX', 'Page Speed']
  },
];
---

<Base
  title="Portfolio — Above The Fold"
  description="Real before and after website transformations for Florida businesses. See our web design, development, and branding work."
>
  <!-- Page hero -->
  <section class="bg-brand-navy pt-20 pb-24 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <svg class="absolute top-0 right-0 w-72 h-72 opacity-[0.04]" viewBox="0 0 288 288" fill="none">
        <path d="M144 18 L162 121 L265 144 L162 167 L144 270 L126 167 L23 144 L126 121 Z" fill="white"/>
      </svg>
      <svg class="absolute bottom-0 left-16 w-40 h-40 opacity-[0.03]" viewBox="0 0 160 160" fill="none">
        <path d="M80 10 L90 68 L148 80 L90 92 L80 150 L70 92 L12 80 L70 68 Z" fill="white"/>
      </svg>
    </div>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center relative">
      <div
        x-data="{ visible: false }"
        x-intersect.once="visible = true"
        :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
        class="transition-all duration-700 ease-out"
      >
        <span class="inline-flex items-center gap-1.5 text-brand-orange font-body font-medium text-xs uppercase tracking-widest mb-5">
          <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 L7 4.8 L12 6 L7 7.2 L6 12 L5 7.2 L0 6 L5 4.8 Z"/></svg>
          Our Case Studies
        </span>
        <h1 class="font-display font-extrabold text-white text-4xl sm:text-5xl tracking-tight mb-5">
          Real Results for Real Florida Businesses
        </h1>
        <p class="font-body text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
          Explore our client success stories. Click on any project card below to see the interactive before-and-after slider and read the full case study details.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Gallery Grid -->
  <section class="py-20 bg-brand-surface">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((project, i) => (
          <div
            x-data="{ visible: false }"
            x-intersect.once="visible = true"
            :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
            class="transition-all duration-700 ease-out flex"
            style={`transition-delay: ${Math.min(i * 80, 200)}ms`}
          >
            <!-- Card Container -->
            <a 
              href={`/portfolio/${project.slug}`}
              class="group flex flex-col bg-white rounded-2xl overflow-hidden border border-brand-navy/5 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 w-full"
            >
              <!-- Card visual preview -->
              <div class="relative overflow-hidden aspect-[16/10] bg-brand-surface border-b border-brand-navy/5 flex-shrink-0">
                <img
                  src={project.afterImg}
                  alt={`${project.name} preview`}
                  class="w-full h-full object-cover object-top select-none group-hover:scale-[1.02] transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/20 to-transparent pointer-events-none"></div>
                <!-- Stat badge -->
                <span class="absolute top-4 right-4 inline-flex items-center gap-1 bg-brand-orange border border-brand-orange/20 text-white font-body text-xs font-semibold px-3 py-1.5 rounded-full shadow-md z-10">
                  <svg class="w-3 h-3 fill-current" viewBox="0 0 12 12"><path d="M6 0 L7 4.8 L12 6 L7 7.2 L6 12 L5 7.2 L0 6 L5 4.8 Z"/></svg>
                  {project.stat}
                </span>
              </div>

              <!-- Card body -->
              <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
                <div>
                  <h2 class="font-display font-extrabold text-brand-navy text-xl sm:text-2xl group-hover:text-brand-orange transition-colors mb-2.5">
                    {project.name}
                  </h2>
                  <p class="font-body text-brand-navy/60 text-sm sm:text-base leading-relaxed mb-6">
                    {project.description}
                  </p>
                </div>

                <div>
                  <!-- Tags -->
                  <div class="flex flex-wrap gap-1.5 mb-6">
                    {project.tags.map((tag) => (
                      <span class="font-body text-[11px] text-brand-navy/50 bg-brand-surface px-2 py-0.5 rounded-md border border-brand-navy/5">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <!-- CTA Arrow -->
                  <span class="inline-flex items-center gap-2 text-brand-orange font-body font-semibold text-sm group-hover:gap-3 transition-all duration-200">
                    Read Case Study
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Base>
