---
const steps = [
  {
    number: '01',
    title: 'Discover',
    description: 'We learn your business goals, audience, and competitive landscape to build a strategy that actually fits.',
  },
  {
    number: '02',
    title: 'Design',
    description: 'Wireframes and high-fidelity mockups crafted to your brand — reviewed and refined until you love it.',
  },
  {
    number: '03',
    title: 'Build',
    description: 'Clean, fast, accessible code deployed on world-class infrastructure for maximum performance.',
  },
  {
    number: '04',
    title: 'Launch',
    description: 'A thorough QA process, SEO setup, and a smooth handoff — no surprises on launch day.',
  },
  {
    number: '05',
    title: 'Grow',
    description: 'Ongoing analytics, updates, and strategy to keep your site ahead of the competition long-term.',
  },
];
---

<section class="py-24 bg-white" id="process">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section header -->
    <div
      x-data="{ visible: false }"
      x-intersect.once="visible = true"
      :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
      class="transition-all duration-700 ease-out text-center mb-20"
    >
      <span class="inline-flex items-center gap-1.5 text-brand-orange font-body font-medium text-xs uppercase tracking-widest mb-4">
        <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 L7 4.8 L12 6 L7 7.2 L6 12 L5 7.2 L0 6 L5 4.8 Z"/></svg>
        Our Process
      </span>
      <h2 class="font-display font-extrabold text-brand-navy text-3xl sm:text-4xl tracking-tight mb-4">
        How We Work
      </h2>
      <p class="font-body text-brand-navy/60 text-lg max-w-2xl mx-auto leading-relaxed">
        A clear, collaborative process with no guesswork — just results from day one.
      </p>
    </div>

    <!-- Desktop: horizontal timeline -->
    <div class="hidden lg:block relative">
      <!-- Orange dashed connector -->
      <div class="absolute top-8 left-[10%] right-[10%] h-px" aria-hidden="true"
        style="border-top: 2px dashed #E8601A; opacity: 0.3;">
      </div>

      <div class="grid grid-cols-5 gap-4">
        {steps.map((step, i) => (
          <div
            x-data="{ visible: false }"
            x-intersect.once="visible = true"
            :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
            class="transition-all duration-700 ease-out relative"
            style={`transition-delay: ${i * 120}ms`}
          >
            <!-- Step number circle -->
            <div class="flex justify-center mb-6">
              <div class="w-16 h-16 rounded-full bg-white border-2 border-brand-orange/20 flex items-center justify-center relative z-10 shadow-sm" style="box-shadow: 0 2px 16px rgba(232,96,26,0.12);">
                <span class="font-display font-extrabold text-brand-navy text-sm">{step.number}</span>
              </div>
            </div>
            <h3 class="font-display font-bold text-brand-navy text-lg text-center mb-2">{step.title}</h3>
            <p class="font-body text-brand-navy/60 text-sm text-center leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile: vertical timeline -->
    <div class="lg:hidden relative pl-8">
      <!-- Vertical dashed line -->
      <div class="absolute left-4 top-4 bottom-4 w-px" aria-hidden="true"
        style="border-left: 2px dashed #E8601A; opacity: 0.3;">
      </div>

      <div class="space-y-10">
        {steps.map((step, i) => (
          <div
            x-data="{ visible: false }"
            x-intersect.once="visible = true"
            :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
            class="transition-all duration-700 ease-out relative"
            style={`transition-delay: ${i * 100}ms`}
          >
            <!-- Step dot -->
            <div class="absolute -left-8 top-1 w-8 h-8 rounded-full bg-white border-2 border-brand-orange/30 flex items-center justify-center z-10 shadow-sm">
              <span class="font-display font-extrabold text-brand-navy text-xs">{step.number}</span>
            </div>
            <h3 class="font-display font-bold text-brand-navy text-lg mb-2">{step.title}</h3>
            <p class="font-body text-brand-navy/60 text-sm leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
