---
const currentPath = Astro.url.pathname;

const links = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'Contact', href: '/contact' },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-[12px] border-b border-black/[0.08]"
  x-data="{ open: false }"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between h-16">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 group" aria-label="Above The Fold home">
      <div class="relative w-8 h-8 flex items-center justify-center">
        <!-- Four-pointed star SVG -->
        <svg class="star-animate w-8 h-8" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 2 L18.5 13.5 L30 16 L18.5 18.5 L16 30 L13.5 18.5 L2 16 L13.5 13.5 Z" fill="#1B2F5E"/>
          <path d="M16 2 L18.5 13.5 L30 16 L18.5 18.5 L16 30 L13.5 18.5 L2 16 L13.5 13.5 Z" fill="#E8601A" opacity="0.35"/>
        </svg>
      </div>
      <div class="flex flex-col leading-none">
        <span class="font-display font-800 text-brand-navy text-[15px] tracking-tight">ABOVE THE FOLD</span>
        <span class="font-body text-[10px] text-brand-orange uppercase tracking-widest">Florida Web Agency</span>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {links.map((link) => (
        <a
          href={link.href}
          class={`nav-link font-body font-medium text-sm text-brand-navy hover:text-brand-orange transition-colors duration-200 ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'text-brand-orange' : ''}`}
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
          {(currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))) && (
            <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-brand-orange"></span>
          )}
        </a>
      ))}
    </nav>

    <!-- Desktop CTA -->
    <div class="hidden md:block">
      <a
        href="/contact"
        class="btn-primary inline-flex items-center gap-2 bg-brand-orange hover:bg-brand-orange-dark text-white font-body font-medium text-sm px-5 py-2.5 rounded-lg shadow-sm"
      >
        Get a Free Quote
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      class="md:hidden flex flex-col gap-1.5 p-2 rounded-lg hover:bg-brand-surface transition-colors"
      @click="open = !open"
      :aria-expanded="open"
      aria-label="Toggle menu"
    >
      <span class="block w-5 h-0.5 bg-brand-navy transition-all duration-300" :class="open ? 'rotate-45 translate-y-2' : ''"></span>
      <span class="block w-5 h-0.5 bg-brand-navy transition-all duration-300" :class="open ? 'opacity-0' : ''"></span>
      <span class="block w-5 h-0.5 bg-brand-navy transition-all duration-300" :class="open ? '-rotate-45 -translate-y-2' : ''"></span>
    </button>
  </div>

  <!-- Mobile full-screen overlay -->
  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
    class="md:hidden absolute top-full left-0 right-0 bg-white border-b border-black/[0.08] shadow-lg"
  >
    <nav class="flex flex-col px-6 py-6 gap-1">
      {links.map((link) => (
        <a
          href={link.href}
          @click="open = false"
          class={`font-body font-medium text-base py-3 px-4 rounded-lg transition-colors duration-200 ${currentPath === link.href ? 'text-brand-orange bg-orange-50' : 'text-brand-navy hover:bg-brand-surface'}`}
        >
          {link.label}
        </a>
      ))}
      <div class="mt-4 pt-4 border-t border-black/[0.06]">
        <a
          href="/contact"
          @click="open = false"
          class="btn-primary block text-center bg-brand-orange hover:bg-brand-orange-dark text-white font-body font-medium text-sm px-5 py-3 rounded-lg"
        >
          Get a Free Quote
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16"></div>
