---
const testimonials = [
  {
    quote: "Above The Fold completely transformed our online presence. Within 90 days of launch, organic traffic was up 180% and our phone was ringing with qualified leads we'd never seen before.",
    name: 'Maria Santos',
    title: 'Owner',
    company: 'Santos Roofing Co.',
    location: 'Tampa, FL',
    initials: 'MS',
  },
  {
    quote: "We'd tried two other agencies before. Night and day difference. The team actually listens, hits every deadline, and our site now converts at 3× the rate it did before. Couldn't be happier.",
    name: 'Derek Holloway',
    title: 'CEO',
    company: 'Gulf Coast HVAC',
    location: 'Sarasota, FL',
    initials: 'DH',
  },
  {
    quote: "The branding package was worth every penny. We went from looking like a side hustle to a serious regional firm. Our clients now trust us before we even walk in the door.",
    name: 'Priya Nair',
    title: 'Principal',
    company: 'Nair Law Group',
    location: 'Orlando, FL',
    initials: 'PN',
  },
];
---

<section class="py-24 bg-brand-surface" id="testimonials">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section header -->
    <div
      x-data="{ visible: false }"
      x-intersect.once="visible = true"
      :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
      class="transition-all duration-700 ease-out text-center mb-16"
    >
      <span class="inline-flex items-center gap-1.5 text-brand-orange font-body font-medium text-xs uppercase tracking-widest mb-4">
        <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor"><path d="M6 0 L7 4.8 L12 6 L7 7.2 L6 12 L5 7.2 L0 6 L5 4.8 Z"/></svg>
        Client Stories
      </span>
      <h2 class="font-display font-extrabold text-brand-navy text-3xl sm:text-4xl tracking-tight mb-4">
        Results Florida Businesses Trust
      </h2>
      <p class="font-body text-brand-navy/60 text-lg max-w-2xl mx-auto leading-relaxed">
        Don't take our word for it — here's what our clients say after working with us.
      </p>
    </div>

    <!-- Carousel -->
    <div
      x-data="{
        current: 0,
        total: 3,
        paused: false,
        init() {
          setInterval(() => {
            if (!this.paused) this.next();
          }, 5000);
        },
        next() { this.current = (this.current + 1) % this.total; },
        prev() { this.current = (this.current - 1 + this.total) % this.total; }
      }"
      @mouseenter="paused = true"
      @mouseleave="paused = false"
      class="relative"
    >
      <!-- Cards -->
      <div class="overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {testimonials.map((t, i) => (
            <div
              x-data="{ visible: false }"
              x-intersect.once="visible = true"
              :class="visible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-6'"
              class="transition-all duration-700 ease-out"
              style={`transition-delay: ${i * 100}ms`}
            >
              <div class="card-lift bg-white rounded-xl p-8 h-full relative" style="box-shadow: 0 2px 20px rgba(0,0,0,0.06);">
                <!-- Decorative quote mark -->
                <div class="absolute top-6 right-6 font-display font-extrabold text-8xl text-brand-orange opacity-[0.07] leading-none select-none" aria-hidden="true">"</div>

                <!-- Stars -->
                <div class="flex gap-1 mb-5">
                  {[1,2,3,4,5].map(() => (
                    <svg class="w-4 h-4 text-brand-orange" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  ))}
                </div>

                <blockquote class="font-body text-brand-navy/75 text-sm leading-relaxed mb-6 relative z-10">
                  "{t.quote}"
                </blockquote>

                <div class="flex items-center gap-3 mt-auto">
                  <div class="w-10 h-10 rounded-full bg-brand-navy flex items-center justify-center flex-shrink-0">
                    <span class="font-display font-bold text-white text-xs">{t.initials}</span>
                  </div>
                  <div>
                    <div class="font-body font-medium text-brand-navy text-sm">{t.name}</div>
                    <div class="font-body text-brand-navy/50 text-xs">{t.title}, {t.company} · {t.location}</div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
